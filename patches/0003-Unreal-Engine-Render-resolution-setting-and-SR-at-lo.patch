+   // Logs an SR diagnostic (e.g. why a TAA pass wasn't replaced by SR), once per distinct message, to diagnose games without spamming the log.
+   // "key" identifies the message, for messages with values that change every frame.
+   static void LogSRDiagnosticOnce(const std::string& message, const std::string& key = {})
+   {
+#if DEVELOPMENT || TEST
+      static std::mutex mutex;
+      static std::unordered_set<std::string> logged;
+      const std::scoped_lock lock(mutex);
+      if (logged.insert(key.empty() ? message : key).second)
+         reshade::log::message(reshade::log::level::info, ("UE4: " + message).c_str());
+#endif
+   }
+
+   // Rewritten every frame, as games can set these console variables at any time (e.g. from their own resolution setting).
+   static void ApplyRenderScaleOverride()
+   {
+      if (!render_scale_cvars_searched)
+      {
+         render_scale_cvars_searched = true;
+         screen_percentage_cvar = static_cast<float*>(UnrealConsoleVariables::FindConsoleVariableData(L"r.ScreenPercentage"));
+         taa_upsampling_cvar = static_cast<int32_t*>(UnrealConsoleVariables::FindConsoleVariableData(L"r.TemporalAA.Upsampling"));
+         // Never write to memory that doesn't hold a plausible value for the variable, in case the code pattern matched something else
+         if (screen_percentage_cvar && !(*screen_percentage_cvar > 0.f && *screen_percentage_cvar <= 400.f))
+         {
+            reshade::log::message(reshade::log::level::warning, std::format("UE4: Ignoring r.ScreenPercentage, its value {} is not plausible", *screen_percentage_cvar).c_str());
+            screen_percentage_cvar = nullptr;
+         }
+         if (taa_upsampling_cvar && (*taa_upsampling_cvar < 0 || *taa_upsampling_cvar > 1))
+         {
+            reshade::log::message(reshade::log::level::warning, std::format("UE4: Ignoring r.TemporalAA.Upsampling, its value {} is not plausible", *taa_upsampling_cvar).c_str());
+            taa_upsampling_cvar = nullptr;
+         }
+         reshade::log::message(reshade::log::level::info, std::format("UE4: Render scale console variables: r.ScreenPercentage {} ({}), r.TemporalAA.Upsampling {} ({})",
+            screen_percentage_cvar ? "found" : "not found", screen_percentage_cvar ? *screen_percentage_cvar : 0.f,
+            taa_upsampling_cvar ? "found" : "not found", taa_upsampling_cvar ? *taa_upsampling_cvar : -1).c_str());
+      }
+      if (!screen_percentage_cvar)
+         return;
+
+      if (render_scale_preset != 0)
+      {
+         if (!render_scale_overridden || *screen_percentage_cvar != overridden_screen_percentage)
+            game_screen_percentage = *screen_percentage_cvar;
+         if (taa_upsampling_cvar && (!render_scale_overridden || *taa_upsampling_cvar != overridden_taa_upsampling))
+            game_taa_upsampling = *taa_upsampling_cvar;
+         render_scale_overridden = true;
+
+         overridden_screen_percentage = render_scale_preset == render_scale_preset_custom ? render_scale_custom : render_scale_presets[render_scale_preset].screen_percentage;
+         *screen_percentage_cvar = overridden_screen_percentage;
+         if (taa_upsampling_cvar)
+         {
+            overridden_taa_upsampling = 1;
+            *taa_upsampling_cvar = overridden_taa_upsampling;
+         }
+      }
+      else if (render_scale_overridden)
+      {
+         *screen_percentage_cvar = game_screen_percentage;
+         if (taa_upsampling_cvar)
+            *taa_upsampling_cvar = game_taa_upsampling;
+         render_scale_overridden = false;
+      }
+   }

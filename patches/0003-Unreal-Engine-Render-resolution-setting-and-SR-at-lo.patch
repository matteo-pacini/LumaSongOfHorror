index 00000000..1dcff8fa
--- /dev/null
+++ b/Source/Games/Unreal Engine/includes/console_variables.hpp	
@@ -0,0 +1,115 @@
+#pragma once
+
+// Finds the storage of Unreal Engine 4 console variables in the game's executable, so mods can change them
+// without the (usually stripped) in-game console.
+
+namespace UnrealConsoleVariables
+{
+   struct ModuleSections
+   {
+      const uint8_t* image_begin = nullptr;
+      const uint8_t* image_end = nullptr;
+      const uint8_t* text_begin = nullptr;
+      const uint8_t* text_end = nullptr;
+      const uint8_t* rdata_begin = nullptr;
+      const uint8_t* rdata_end = nullptr;
+   };
+
+   inline bool GetMainModuleSections(ModuleSections& sections)
+   {
+      const auto* base = reinterpret_cast<const uint8_t*>(GetModuleHandleW(nullptr));
+      if (!base)
+         return false;
+      const auto* dos_header = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);
+      const auto* nt_headers = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + dos_header->e_lfanew);
+      if (dos_header->e_magic != IMAGE_DOS_SIGNATURE || nt_headers->Signature != IMAGE_NT_SIGNATURE || nt_headers->FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64)
+         return false;
+      sections.image_begin = base;
+      sections.image_end = base + nt_headers->OptionalHeader.SizeOfImage;
+      const IMAGE_SECTION_HEADER* section = IMAGE_FIRST_SECTION(nt_headers);
+      for (WORD i = 0; i < nt_headers->FileHeader.NumberOfSections; i++, section++)
+      {
+         const uint8_t* begin = base + section->VirtualAddress;
+         const uint8_t* end = begin + section->Misc.VirtualSize;
+         if (std::memcmp(section->Name, ".text\0\0", 8) == 0)
+         {
+            sections.text_begin = begin;
+            sections.text_end = end;
+         }
+         else if (std::memcmp(section->Name, ".rdata\0", 8) == 0)
+         {
+            sections.rdata_begin = begin;
+            sections.rdata_end = end;
+         }
+      }
+      return sections.text_begin && sections.rdata_begin;
+   }
+
+   inline int32_t ReadRel32(const uint8_t* address)
+   {
+      int32_t value;
+      std::memcpy(&value, address, sizeof(value));
+      return value;
+   }
+
+   // Returns the "TConsoleVariableData<T>" (whose first member is the variable's value on the game thread) of the console
+   // variable with the given name, or null if it couldn't be found.
+   // UE4 keeps a static pointer to it for every "TAutoConsoleVariable" (registration) and every cached
+   // "IConsoleManager::FindTConsoleVariableData*()" lookup, and MSVC compiles both to:
+   //   lea rdx, [rip + <name>]                  48 8D 15 <rel32>
+   //   ...  call qword ptr [rax + <offset>]     the IConsoleManager register/find function
+   //   ...  call qword ptr [rdx + <offset8>]    FF 52 <offset8>: IConsoleObject::AsVariable{Int,Float}()
+   //   ...  mov qword ptr [rip + <static>], rax 48 89 05 <rel32>
+   // The executable's code must already be decrypted (e.g. by Steam's DRM), which is the case once the game renders.
+   inline void* FindConsoleVariableData(const wchar_t* name)
+   {
+      ModuleSections sections;
+      if (!GetMainModuleSections(sections))
+         return nullptr;
+
+      // The name as a null terminated UTF-16 string. The compiler can emit more than one copy of it.
+      const size_t name_size = (std::wcslen(name) + 1) * sizeof(wchar_t);
+      std::vector<const uint8_t*> name_copies;
+      for (const uint8_t* p = sections.rdata_begin; p + name_size <= sections.rdata_end; p += sizeof(wchar_t))
+      {
+         if (std::memcmp(p, name, name_size) == 0)
+            name_copies.push_back(p);
+      }
+      if (name_copies.empty())
+         return nullptr;
+
+      constexpr size_t lea_size = 7; // Also the size of the "mov [rip + <static>], rax"
+      constexpr size_t call_size = 3;
+      constexpr size_t max_call_distance = 64; // Bytes from the name's "lea" to the "AsVariable*()" call
+      constexpr size_t max_store_distance = 16; // Bytes from the "AsVariable*()" call to the store of its result
+      for (const uint8_t* p = sections.text_begin; p + lea_size + max_call_distance + call_size + max_store_distance + lea_size <= sections.text_end; p++)
+      {
+         if (p[0] != 0x48 || p[1] != 0x8D || p[2] != 0x15)
+            continue;
+         const uint8_t* lea_target = p + lea_size + ReadRel32(p + 3);
+         if (std::find(name_copies.begin(), name_copies.end(), lea_target) == name_copies.end())
+            continue;
+
+         for (const uint8_t* call = p + lea_size; call < p + lea_size + max_call_distance; call++)
+         {
+            if (call[0] != 0xFF || call[1] != 0x52)
+               continue;
+            for (const uint8_t* store = call + 3; store < call + 3 + max_store_distance; store++)
+            {
+               if (store[0] != 0x48 || store[1] != 0x89 || store[2] != 0x05)
+                  continue;
+               const uint8_t* static_pointer = store + lea_size + ReadRel32(store + 3);
+               if (static_pointer < sections.image_begin || static_pointer + sizeof(void*) > sections.image_end)
+                  break;
+               // Cached lookups are only initialized once their function runs, so they can still be null.
+               void* data = *reinterpret_cast<void* const*>(static_pointer);
+               if (data)
+                  return data;
+               break;
+            }
+            break;
+         }
+      }
+      return nullptr;
+   }
+} // namespace UnrealConsoleVariables
